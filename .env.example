# Branding
ORG_NAME=University of Technology Sydney

# Cloudinary — upload ảnh màu ({id}_photo) + layout strip màu ({id}_layout) cho guest download
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=bkfire-thermalphotobooth

# Trang guest Render (tuỳ chọn). QR DOWNLOAD = Cloudinary trực tiếp khi đã cấu hình Cloudinary.
PUBLIC_BASE_URL=https://thermal-photobooth.onrender.com

# Fallback QR khi Cloudinary chưa cấu hình. {id} = photo id.
QR_BASE_URL=https://thermal-photobooth.onrender.com/photo/{id}

# QR "SCAN TO REGISTER" — dán link Google Form khi có
REGISTER_QR_URL=https://www.youtube.com

# Camera: auto (Sony nếu có, không thì MacBook) | gphoto | webcam
CAMERA_BACKEND=auto
WEBCAM_DEVICE_INDEX=0

# Printer: usb | cups | file
PRINTER_BACKEND=cups
PRINTER_VENDOR_ID=0xfe6
PRINTER_PRODUCT_ID=0x811e
PRINTER_CUPS_NAME=Manufacture_Virtual_PRN

# USB: delay giữa chunk ghi (không chia dải ảnh). Tăng nếu lệch sync / mã rác.
PRINTER_BAND_PACE_SEC=0.020
PRINTER_HEAT_DOTS=7
PRINTER_HEAT_TIME=70
PRINTER_HEAT_INTERVAL=4

# Tách nền chủ thể trước khi dither / in (true|false). Mặc định tắt — giữ nền chụp.
REMOVE_BACKGROUND=false

# Overlay film-strip lên ảnh (RGBA). Mặc định: assets/uts_frame_border.png
# FRAME_BORDER_PATH=assets/uts_frame_border.png

# Template màu upload Cloudinary. Mặc định: assets/uts_upload_layout_template.png
# PRINT_TEMPLATE_COLORED_PATH=assets/uts_upload_layout_template.png

# Template B&W in nhiệt. Mặc định: assets/uts_print_layout_template.png
# PRINT_TEMPLATE_PATH=assets/uts_print_layout_template.png

# Web
HOST=0.0.0.0
PORT=8000
